+        public IntuosProAuxReport(byte[] report)
+        {
+            Raw = report;
+
+            var touchWheelButtonByte = report[3];
+            var auxByte = report[4];
+
+            AuxButtons = new bool[]
+            {
+                auxByte.IsBitSet(0),
+                auxByte.IsBitSet(1),
+                auxByte.IsBitSet(2),
+                auxByte.IsBitSet(3),
+                auxByte.IsBitSet(4),
+                auxByte.IsBitSet(5),
+                auxByte.IsBitSet(6),
