diff --git a/OpenTabletDriver.Configurations/Parsers/Huion/HuionTiltReportParser.cs b/OpenTabletDriver.Configurations/Parsers/Huion/HuionTiltReportParser.cs
new file mode 100644
index 00000000..90904265
--- /dev/null
+++ b/OpenTabletDriver.Configurations/Parsers/Huion/HuionTiltReportParser.cs
@@ -0,0 +1,18 @@
+using OpenTabletDriver.Configurations.Parsers.UCLogic;
+using OpenTabletDriver.Plugin.Tablet;
+
+namespace OpenTabletDriver.Configurations.Parsers.Huion
+{
+    public class HuionTiltReportParser : IReportParser<IDeviceReport>
+    {
+        public IDeviceReport Parse(byte[] data)
+        {
+            return data[1] switch
+            {
+                0xE0 => new InspiroyAuxReport(data),
+                0xF0 => new HuionWheelReport(data),
+                _ => new TiltTabletReport(data)
+            };
+        }
+    }
+}
diff --git a/OpenTabletDriver.Configurations/Parsers/Huion/HuionWheelReport.cs b/OpenTabletDriver.Configurations/Parsers/Huion/HuionWheelReport.cs
new file mode 100644
index 00000000..e8585ea1
--- /dev/null
+++ b/OpenTabletDriver.Configurations/Parsers/Huion/HuionWheelReport.cs
@@ -0,0 +1,21 @@
+using OpenTabletDriver.Plugin.Tablet.Wheel;
+
+namespace OpenTabletDriver.Configurations.Parsers.Huion;
+
+public class HuionWheelReport : IAbsoluteWheelReport
+{
+    public HuionWheelReport(byte[] data)
+    {
+        Raw = data;
+        var wheelData = data[5];
+
+        if (wheelData == 0)
+            Position = null;
+        else
+            Position = wheelData - 1u;
+    }
+
+    public byte[] Raw { get; set; }
+    public uint? Position { get; set; }
+    public bool[] WheelButtons { get; set; }
+}
diff --git a/OpenTabletDriver.Configurations/Parsers/Huion/InspiroyAuxReport.cs b/OpenTabletDriver.Configurations/Parsers/Huion/InspiroyAuxReport.cs
new file mode 100644
index 00000000..0994ed41
--- /dev/null
+++ b/OpenTabletDriver.Configurations/Parsers/Huion/InspiroyAuxReport.cs
@@ -0,0 +1,45 @@
+using OpenTabletDriver.Plugin.Tablet;
+using OpenTabletDriver.Plugin.Tablet.Wheel;
+
+namespace OpenTabletDriver.Configurations.Parsers.UCLogic
+{
+    public struct InspiroyAuxReport : IAuxReport, IWheelButtonReport
+    {
+        public InspiroyAuxReport(byte[] report)
+        {
+            Raw = report;
+
+            AuxButtons = new bool[]
+            {
+                report[4].IsBitSet(0),
+                report[4].IsBitSet(1),
+                report[4].IsBitSet(2),
+                report[4].IsBitSet(3),
+                report[4].IsBitSet(4),
+                report[4].IsBitSet(5),
+                report[4].IsBitSet(6),
+                report[4].IsBitSet(7),
+                report[5].IsBitSet(0),
+                report[5].IsBitSet(1),
+                report[5].IsBitSet(2),
+                report[5].IsBitSet(3),
+                report[5].IsBitSet(5),
+                report[5].IsBitSet(6),
+                report[5].IsBitSet(7),
+                report[6].IsBitSet(0),
+                report[6].IsBitSet(1),
+                report[6].IsBitSet(2),
+                report[6].IsBitSet(3)
+            };
+
+            WheelButtons = new bool[]
+            {
+                report[5].IsBitSet(4)
+            };
+        }
+
+        public bool[] AuxButtons { set; get; }
+        public bool[] WheelButtons { set; get; }
+        public byte[] Raw { set; get; }
+    }
+}
diff --git a/OpenTabletDriver.Configurations/Parsers/UCLogic/UCLogicV1ReportParser.cs b/OpenTabletDriver.Configurations/Parsers/UCLogic/UCLogicV1ReportParser.cs
new file mode 100644
index 00000000..e9c7224a
--- /dev/null
+++ b/OpenTabletDriver.Configurations/Parsers/UCLogic/UCLogicV1ReportParser.cs
@@ -0,0 +1,17 @@
+using OpenTabletDriver.Plugin.Tablet;
+
+namespace OpenTabletDriver.Configurations.Parsers.UCLogic
+{
+    public class UCLogicV1ReportParser : IReportParser<IDeviceReport>
+    {
+        public IDeviceReport Parse(byte[] data)
+        {
+            if (data[1] == 0xE0)
+                return new UCLogicAuxReport(data);
+            else if (data[1].IsBitSet(6))
+                return new TabletReport(data);
+            else
+                return new OutOfRangeReport(data);
+        }
+    }
+}
diff --git a/OpenTabletDriver.Configurations/Parsers/Wacom/BambooV2/BambooV2AuxReportParser.cs b/OpenTabletDriver.Configurations/Parsers/Wacom/BambooV2/BambooV2AuxReportParser.cs
new file mode 100644
index 00000000..35af2ab7
--- /dev/null
+++ b/OpenTabletDriver.Configurations/Parsers/Wacom/BambooV2/BambooV2AuxReportParser.cs
@@ -0,0 +1,17 @@
+using OpenTabletDriver.Configurations.Parsers.Wacom.IntuosV2;
+using OpenTabletDriver.Plugin.Tablet;
+
+namespace OpenTabletDriver.Configurations.Parsers.Wacom.BambooV2
+{
+    public class BambooV2AuxReportParser : IReportParser<IDeviceReport>
+    {
+        public virtual IDeviceReport Parse(byte[] data)
+        {
+            return data[0] switch
