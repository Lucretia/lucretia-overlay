	[glutin]='https://github.com/rust-windowing/glutin.git;07c461ee4642ba07b1bc01931f3996643d7f1835;%commit%'
)

inherit cargo # ecm gear.kde.org


DESCRIPTION="Thumbnail generator for STL files"
HOMEPAGE="https://github.com/unlimitedbacon/stl-thumb"

SRC_URI="https://github.com/unlimitedbacon/stl-thumb/archive/v${PV}.tar.gz -> ${P}.tar.gz"

LICENSE="MIT"
SLOT="6"
KEYWORDS="~amd64 ~arm64 ~loong ~ppc64 ~riscv ~x86"

